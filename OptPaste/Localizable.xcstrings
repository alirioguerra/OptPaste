{
  "sourceLanguage": "en",
  "strings": {
    "%@ cuts the selected files and ⌘V moves them to the open folder instead of copying.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recorta os arquivos selecionados e ⌘V os move para a pasta aberta, em vez de copiar."
          }
        }
      }
    },
